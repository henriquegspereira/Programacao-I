@model List<Model.Product>

@{
    ViewData["Title"] = "Product List";
}
<a asp-controller="Product" asp-action="Create">
    Create Product
</a>
<table class="table table-striped table-responsive">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Price</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>@product.Price</td>
                <td>
                    <a asp-controller="Product"
                       asp-action="Edit"
                       asp-route-id="@product.Id">Edit</a>
                    <a asp-controller="Product"
                       asp-action="Delete"
                       asp-route-id="@product.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>